{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && node scripts/prerender.mjs",
    "preview": "./scripts/preview.sh",
    "prebuild": "node scripts/validate-config.mjs --warn-only",
    "build:only": "vite build",
    "build:strict": "node scripts/validate-config.mjs --strict && npm run typecheck && vite build && node scripts/prerender.mjs --strict",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "config:check": "node scripts/validate-config.mjs --warn-only",
    "config:check:strict": "node scripts/validate-config.mjs --strict",
    "seo:public": "node scripts/prerender.mjs --public-only",
    "ai:gateway": "node server/ai-server.mjs",
    "smoke:routes": "node scripts/route-smoke.mjs",
    "audit:links": "node scripts/link-audit.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run audit:links && npm run build && npm run smoke:routes"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "4.1.17",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0",
    "vitest": "^5.0.3"
  }
}
